# Railway supplies PORT and DATABASE_URL automatically when a Postgres service is linked.
APP_URL=https://your-app.up.railway.app
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/product_writer
COOKIE_SECRET=replace-with-a-long-random-value
